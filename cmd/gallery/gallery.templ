// searchScript filters the page client-side. The input starts [hidden] and is
// revealed here, so without JavaScript there is no dead control on screen --
// the rail already lists every component.
templ searchScript() {
	<script type="text/javascript">
		(function () {
			var box = document.getElementById("gal-search");
			var input = document.getElementById("gal-q");
			var count = document.getElementById("gal-count");
			var empty = document.getElementById("gal-empty");
			if (!box || !input) return;
			box.hidden = false;

			var sections = Array.prototype.slice.call(document.querySelectorAll(".gal-sec"));
			var links = Array.prototype.slice.call(document.querySelectorAll(".gal-index a[data-for]"));
			var groups = Array.prototype.slice.call(document.querySelectorAll("[data-group]"));
			var total = sections.length;

			// Fold accents so "systeme" finds "système".
			function fold(s) {
				return s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
			}

			var haystacks = sections.map(function (el) { return fold(el.dataset.search || ""); });
			var linkFor = {};
			links.forEach(function (a) { linkFor[a.dataset.for] = a; });

			function apply(raw) {
				var terms = fold(raw).split(/\s+/).filter(Boolean);
				var shown = 0;
				var liveGroups = {};

				sections.forEach(function (el, i) {
					var hit = terms.every(function (t) { return haystacks[i].indexOf(t) !== -1; });
					el.hidden = !hit;
					var link = linkFor[el.id];
					if (link) link.hidden = !hit;
					if (hit) {
						shown++;
						liveGroups[el.dataset.group || ""] = true;
					}
				});

				// A group heading with nothing under it is noise.
				groups.forEach(function (h) { h.hidden = !liveGroups[h.dataset.group]; });

				empty.hidden = shown !== 0;
				count.textContent = terms.length === 0
					? total + " composants"
					: shown + " sur " + total;
			}

			// Each section needs to know its group to hide empty headings.
			var current = "";
			Array.prototype.forEach.call(document.querySelectorAll(".gal-main > *"), function (el) {
				if (el.classList.contains("gal-group")) current = el.dataset.group;
				else if (el.classList.contains("gal-sec")) el.dataset.group = current;
			});

			input.addEventListener("input", function () { apply(input.value); });
			input.addEventListener("keydown", function (e) {
				if (e.key === "Escape") { input.value = ""; apply(""); input.blur(); }
			});
			document.addEventListener("keydown", function (e) {
				if (e.key === "/" && document.activeElement !== input) {
					e.preventDefault();
					input.focus();
					input.select();
				}
			});

			apply("");
		})();
	</script>
}
