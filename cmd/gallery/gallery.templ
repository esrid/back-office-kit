package main

import "github.com/esrid/back-office-kit/ui"
import "strconv"
import "net/url"

templ Gallery(secs []Section) {
	<div class="gal">
		<aside class="gal-rail">
			<div class="gal-brand">
				<span class="gal-brand-mark"></span>
				<span>Back-office kit</span>
			</div>
			<p class="gal-brand-sub">templ · daisyUI 5 · Unpoly 3</p>
			<div class="gal-search" hidden id="gal-search">
				<input
					type="search"
					id="gal-q"
					placeholder="Filtrer…"
					aria-label="Filtrer les composants"
					aria-describedby="gal-count"
					autocomplete="off"
				/>
				<kbd>/</kbd>
			</div>
			<p class="gal-count" id="gal-count" role="status" aria-live="polite"></p>
			<nav class="gal-index">
				for i, s := range secs {
					if i == 0 || s.Group != secs[i-1].Group {
						<span class="gal-index-group" data-group={ s.Group }>{ s.Group }</span>
					}
					<a href={ templ.SafeURL("#" + s.ID) } data-for={ s.ID }>
						<span class="gal-index-n">{ pad(s.N) }</span>
						<span>{ s.Title }</span>
					</a>
				}
			</nav>
			<p class="gal-rail-foot">Ordre de construction : chaque bloc ne dépend que des précédents.</p>
		</aside>
		<main class="gal-main">
			<header class="gal-head">
				<p class="gal-eyebrow">{ strconv.Itoa(len(secs)) } exemples · templ + daisyUI 5 + Unpoly 3</p>
				<h1>Ce que daisyUI ne fait pas encore</h1>
				<p class="gal-lede">
					daisyUI donne les primitives. La première série ajoute la sémantique back-office :
					tri et pagination portés par l'URL, validation serveur par champ, états vides,
					statuts cohérents. La suite couvre écrans métier, workflows serveur et interactions
					agentiques : plan, approbation, exécution observable, reçu, annulation et relais humain.
					Les niveaux suivants traitent gouvernance, sécurité, accès et coordination entre opérateurs.
					Les outils avancés ajoutent commandes globales, requêtes composées et vues de traitement denses.
					Rendu réel, pas des maquettes.
				</p>
			</header>
			for i, s := range secs {
				if i == 0 || s.Group != secs[i-1].Group {
					<h2 class="gal-group" data-group={ s.Group }>{ s.Group }</h2>
				}
				@sectionView(s)
			}
			<p class="gal-empty" id="gal-empty" hidden>Aucun composant ne correspond.</p>
			@searchScript()
			<footer class="gal-foot">
				<p>Toute la logique d'URL (tri, pagination) est pure et testée : <code>go test ./ui/</code></p>
			</footer>
		</main>
	</div>
}

templ sectionView(s Section) {
	<section class="gal-sec" id={ s.ID } data-search={ s.Search }>
		<div class="gal-sec-head">
			<span class="gal-sec-n">{ pad(s.N) }</span>
			<div class="gal-sec-meta">
				<h3>{ s.Title }</h3>
				<p class="gal-purpose">{ s.Purpose }</p>
				<p class="gal-uses">
					for _, u := range s.Uses {
						<code>{ u }</code>
					}
				</p>
			</div>
		</div>
		<div class={ "gal-stage", s.StageClass }>
			@s.Demo
		</div>
		if s.Signature != "" {
			<p class="gal-sig"><code>{ s.Signature }</code></p>
		}
		if s.Snippet != "" {
			<pre class="gal-code"><code>{ s.Snippet }</code></pre>
		}
		if s.Note != "" {
			<p class="gal-note">{ s.Note }</p>
		}
	</section>
}

func pad(n int) string {
	if n < 10 {
		return "0" + strconv.Itoa(n)
	}
	return strconv.Itoa(n)
}

templ demoShell() {
	@ui.Shell("Utilisateurs", demoNav(), "/users", "amelie@acme.co", []ui.Flash{}) {
