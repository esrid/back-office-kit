			Name: "email", Label: "E-mail", Type: "email", Value: "amelie@acme",
			Error: "Cette adresse est déjà utilisée par un autre compte.", Required: true, Validate: true,
		})
		@ui.SelectField(ui.FieldProps{
			Name: "role", Label: "Rôle", Value: "admin", Hint: "Détermine l'accès à la facturation.",
		}, []ui.Option{
			{Value: "admin", Label: "Administrateur"},
			{Value: "member", Label: "Membre"},
			{Value: "viewer", Label: "Lecture seule"},
		})
