package ui

import "strconv"

type AgentRole string

const (
	AgentUser      AgentRole = "user"
	AgentAssistant AgentRole = "assistant"
	AgentSystem    AgentRole = "system"
)

type AgentThreadProps struct {
	ID         string
	Title      string
	Busy       bool
	PollSource string
}

func agentMessageClass(role AgentRole) string {
	switch role {
	case AgentUser:
		return "chat-end"
	case AgentSystem:
		return "chat-start opacity-75"
	default:
		return "chat-start"
	}
}

func agentBubbleClass(role AgentRole) string {
	if role == AgentUser {
		return "chat-bubble-primary"
	}
	return "bg-base-200 text-base-content"
}

// AgentWorkspace composes the conversational surface with a plan, approval or
// execution sidebar that drops below the thread on narrower screens.
templ AgentWorkspace(title string, subtitle string, sidebar templ.Component) {
	<section class="flex flex-col gap-4">
		<header>
			<h1 class="text-xl font-semibold">{ title }</h1>
			if subtitle != "" {
				<p class="text-sm opacity-60 mt-1">{ subtitle }</p>
			}
		</header>
		<div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(19rem,24rem)] gap-4 items-start">
			<div class="flex flex-col gap-3 min-w-0">
				{ children... }
			</div>
			if sidebar != nil {
				<aside class="min-w-0 lg:sticky lg:top-4">
					@sidebar
				</aside>
			}
		</div>
	</section>
}

// AgentThread is the live conversation region. PollSource optionally refreshes
// it while the backend is producing a response or executing approved work.
templ AgentThread(p AgentThreadProps) {
	<section
		id={ p.ID }
		class="flex flex-col min-h-0 rounded-box border border-base-300 bg-base-100"
		aria-label={ p.Title }
		aria-busy={ strconv.FormatBool(p.Busy) }
		if p.Busy && p.PollSource != "" {
			up-poll
			up-interval="1000"
			up-source={ p.PollSource }
		}
	>
		<header class="flex items-center justify-between gap-3 border-b border-base-300 px-4 py-3">
			<h2 class="font-semibold">{ p.Title }</h2>
			if p.Busy {
				<span class="inline-flex items-center gap-2 text-xs opacity-60"><span class="loading loading-dots loading-xs"></span>En cours</span>
			}
		</header>
		<div class="overflow-y-auto" role="log" aria-live="polite" aria-relevant="additions">
			<ol class="flex flex-col gap-3 p-4">
				{ children... }
			</ol>
		</div>
	</section>
}

// AgentMessage renders one conversational turn while preserving its author.
templ AgentMessage(role AgentRole, author string, timestamp string) {
	<li class={ "chat", agentMessageClass(role) }>
		<div class="chat-header text-xs opacity-60">{ author } <time>{ timestamp }</time></div>
		<div class={ "chat-bubble text-sm", agentBubbleClass(role) }>
			{ children... }
		</div>
	</li>
}

type AgentContext struct {
	Label      string
	Value      string
	RemoveHref string
}

type AgentComposerProps struct {
	ID          string
	Action      string
	Name        string
	Value       string
	Placeholder string
	SendLabel   string
	Disabled    bool
	Contexts    []AgentContext
}

func agentComposerID(p AgentComposerProps) string {
	if p.ID != "" {
		return p.ID
	}
	return "agent-prompt"
}

func agentSendLabel(label string) string {
	if label == "" {
		return "Envoyer"
	}
	return label
}

// AgentComposer submits an ordinary server form and exposes the exact context
// that will accompany the user's instruction.
templ AgentComposer(p AgentComposerProps) {
	<form method="post" action={ templ.SafeURL(p.Action) } up-submit class="flex flex-col gap-2 rounded-box border border-base-300 bg-base-100 p-3">
		if len(p.Contexts) > 0 {
			<ul class="flex flex-wrap gap-1.5" aria-label="Contexte joint">
				for _, item := range p.Contexts {
					<li class="badge badge-ghost gap-1.5 max-w-full">
						<span class="truncate">{ item.Label }: { item.Value }</span>
						if item.RemoveHref != "" {
							<button type="submit" formaction={ templ.SafeURL(item.RemoveHref) } formnovalidate class="font-bold cursor-pointer" aria-label={ "Retirer " + item.Label }>×</button>
						}
					</li>
				}
			</ul>
		}
		<label class="sr-only" for={ agentComposerID(p) }>Votre demande</label>
		<textarea id={ agentComposerID(p) } class="textarea w-full min-h-24 resize-y" name={ p.Name } placeholder={ p.Placeholder } disabled?={ p.Disabled }>{ p.Value }</textarea>
		<div class="flex items-center justify-between gap-3"><p class="text-xs opacity-50">Vérifiez toujours le plan avant une action sensible.</p><button type="submit" class="btn btn-primary btn-sm" disabled?={ p.Disabled }>{ agentSendLabel(p.SendLabel) }</button></div>
	</form>
}

type AgentSuggestion struct {
	Label       string
	Description string
	Href        string
	Risk        AgentRisk
}

// AgentSuggestionSet offers bounded next actions instead of forcing another
// free-form prompt.
templ AgentSuggestionSet(title string, suggestions []AgentSuggestion, target string) {
	<section class="flex flex-col gap-2" aria-label={ title }>
		<h3 class="text-sm font-medium">{ title }</h3>
		<div class="grid sm:grid-cols-2 gap-2">
			for _, suggestion := range suggestions {
				<a
					href={ templ.SafeURL(suggestion.Href) }
					up-follow
					if target != "" {
						up-target={ target }
					}
					class="group rounded-box border border-base-300 p-3 hover:border-primary focus-visible:outline-2 focus-visible:outline-primary"
				>
					<div class="flex items-start justify-between gap-2">
						<span class="font-medium text-sm">{ suggestion.Label }</span>@AgentRiskBadge(suggestion.Risk)
					</div>
					<p class="text-xs opacity-60 mt-1">{ suggestion.Description }</p>
				</a>
			}
		</div>
	</section>
}
