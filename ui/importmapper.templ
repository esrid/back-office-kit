package ui

import "strconv"

// ImportField is a destination the import can write into.
type ImportField struct {
	Name     string
	Label    string
	Required bool
}

// ImportColumn is one column found in the uploaded file.
type ImportColumn struct {
	Source  string   // header as it appears in the file
	Samples []string // first values, so the operator maps on evidence
	Target  string   // currently selected ImportField.Name, empty to ignore
}

type ImportMapperProps struct {
	ID       string
	Action   string
	RowCount int
	Columns  []ImportColumn
	Fields   []ImportField
}

// unmappedRequired lists the required fields no column feeds. This is the whole
// point of the screen: an import that silently drops a required column is how
// data gets quietly wrong.
func unmappedRequired(fields []ImportField, columns []ImportColumn) []ImportField {
	mapped := make(map[string]bool, len(columns))
	for _, c := range columns {
		if c.Target != "" {
			mapped[c.Target] = true
		}
	}
	var missing []ImportField
	for _, f := range fields {
		if f.Required && !mapped[f.Name] {
			missing = append(missing, f)
		}
	}
	return missing
}

// duplicateTargets lists fields fed by more than one column, which would make
// the last column silently win.
func duplicateTargets(fields []ImportField, columns []ImportColumn) []ImportField {
	count := map[string]int{}
	for _, c := range columns {
		if c.Target != "" {
			count[c.Target]++
		}
	}
	var dupes []ImportField
	for _, f := range fields {
		if count[f.Name] > 1 {
			dupes = append(dupes, f)
		}
	}
	return dupes
}

// ImportMapper pairs file columns with destination fields. JobProgress covers
// running the import; this covers the step where a human decides that
// "Email address" means email -- the step where data actually breaks.
templ ImportMapper(p ImportMapperProps) {
	{{ missing := unmappedRequired(p.Fields, p.Columns) }}
	{{ dupes := duplicateTargets(p.Fields, p.Columns) }}
	<form id={ p.ID } method="post" action={ templ.SafeURL(p.Action) } up-submit class="flex flex-col gap-4">
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<h2 class="font-semibold">Associer les colonnes</h2>
			<p class="text-sm opacity-60">
				{ strconv.Itoa(len(p.Columns)) } { plural(len(p.Columns), "colonne détectée", "colonnes détectées") } ·
				{ strconv.Itoa(p.RowCount) } { plural(p.RowCount, "ligne", "lignes") }
			</p>
		</div>
		for _, f := range missing {
			<div role="alert" class="alert alert-warning">
				<span>Le champ obligatoire <strong>{ f.Label }</strong> n'est associé à aucune colonne.</span>
			</div>
		}
		for _, f := range dupes {
			<div role="alert" class="alert alert-warning">
				<span>Plusieurs colonnes alimentent <strong>{ f.Label }</strong> : la dernière écraserait les autres.</span>
			</div>
		}
		<div class="overflow-x-auto rounded-box border border-base-300">
			<table class="table table-sm">
				<thead>
					<tr><th class="w-1/3">Colonne du fichier</th><th>Exemples</th><th class="w-1/3">Champ de destination</th></tr>
				</thead>
				<tbody>
					for i, c := range p.Columns {
						<tr>
							<td class="font-medium align-top">{ c.Source }</td>
							<td class="align-top">
								<ul class="text-xs opacity-60 flex flex-col gap-0.5">
									for _, sample := range c.Samples {
										<li class="truncate max-w-56">{ sample }</li>
									}
								</ul>
							</td>
							<td class="align-top">
								<label class="sr-only" for={ p.ID + "-col-" + strconv.Itoa(i) }>Destination de { c.Source }</label>
								<select
									id={ p.ID + "-col-" + strconv.Itoa(i) }
									name={ "column[" + c.Source + "]" }
									class="select select-sm w-full"
									up-validate
								>
									<option value="" selected?={ c.Target == "" }>Ignorer cette colonne</option>
									for _, f := range p.Fields {
										<option value={ f.Name } selected?={ f.Name == c.Target }>
											{ f.Label }
											if f.Required {
												{ " (obligatoire)" }
											}
										</option>
									}
								</select>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="flex items-center gap-2">
			<button type="submit" class="btn btn-primary btn-sm" disabled?={ len(missing) > 0 }>Lancer l'import</button>
			if len(missing) > 0 {
				<span class="text-sm opacity-60">Associez les champs obligatoires pour continuer.</span>
			}
		</div>
	</form>
}
