package ui

type AuthCardProps struct {
	Product   string
	Title     string
	Subtitle  string
	HeroTitle string
	HeroText  string
}

// AuthCard is a login screen with a quiet product hero and a focused form card.
templ AuthCard(p AuthCardProps) {
	<div class="min-h-screen grid lg:grid-cols-[minmax(0,1fr)_minmax(24rem,34rem)] bg-base-200">
		<section class="hidden lg:flex flex-col justify-between bg-primary text-primary-content p-10 xl:p-14" aria-label="Présentation">
			<p class="font-semibold tracking-tight">{ p.Product }</p>
			<div class="max-w-lg">
				<h2 class="text-3xl xl:text-4xl font-semibold tracking-tight text-balance">{ p.HeroTitle }</h2>
				if p.HeroText != "" {
					<p class="mt-3 opacity-80 max-w-prose">{ p.HeroText }</p>
				}
			</div>
			<p class="text-sm opacity-70">Accès sécurisé</p>
		</section>
		<main class="grid place-items-center p-4 sm:p-8">
			<div class="card card-border bg-base-100 w-full max-w-sm">
				<div class="card-body p-6 sm:p-8">
					<p class="lg:hidden font-semibold text-primary">{ p.Product }</p>
					<div>
						<h1 class="card-title text-xl">{ p.Title }</h1>
						if p.Subtitle != "" {
							<p class="text-sm opacity-60 mt-1">{ p.Subtitle }</p>
						}
					</div>
					{ children... }
				</div>
			</div>
		</main>
	</div>
}
