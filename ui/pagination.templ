package ui

import "net/url"
import "strconv"

// gap marks an ellipsis slot in the slice returned by Pages.
const gap = 0

// Pages returns the page numbers to render for current within totalPages:
// always the first and last page, the current page and its neighbours, and
// gap (0) wherever pages were skipped. Returns nil when there is nothing to
// paginate. Pure and deterministic.
func Pages(current, totalPages int) []int {
	if totalPages < 2 {
		return nil
	}
	current = min(max(current, 1), totalPages)

	keep := map[int]bool{1: true, totalPages: true}
	for p := current - 1; p <= current+1; p++ {
		if p >= 1 && p <= totalPages {
			keep[p] = true
		}
	}

	out := make([]int, 0, len(keep)+2)
	prev := 0
	for p := 1; p <= totalPages; p++ {
		if !keep[p] {
			continue
		}
		if prev != 0 && p != prev+1 {
			out = append(out, gap)
		}
		out = append(out, p)
		prev = p
	}
	return out
}

// TotalPages is the page count for n items at perPage per page.
func TotalPages(n, perPage int) int {
	if perPage < 1 || n <= 0 {
		return 0
	}
	return (n + perPage - 1) / perPage
}

// PageHref returns the query string for page, preserving other params.
// Pure: q is never mutated.
func PageHref(q url.Values, page int) string {
	n := cloneValues(q)
	if page <= 1 {
		n.Del("page")
	} else {
		n.Set("page", strconv.Itoa(page))
	}
	if len(n) == 0 {
		return "?"
	}
	return "?" + n.Encode()
}

func ariaCurrent(on bool) string {
	if on {
		return "page"
	}
	return "false"
}

// Pagination renders a page selector. target is the CSS selector Unpoly
// swaps -- pass the DataTable container id (e.g. "#users") so rows and
// pagination update together.
templ Pagination(current int, totalItems int, perPage int, q url.Values, target string) {
	{{ total := TotalPages(totalItems, perPage) }}
	{{ pages := Pages(current, total) }}
	if len(pages) > 0 {
		<nav class="flex items-center justify-between gap-4 flex-wrap" aria-label="Pagination">
			<p class="text-sm opacity-60">
				{ strconv.Itoa(totalItems) } résultats · page { strconv.Itoa(current) } sur { strconv.Itoa(total) }
			</p>
			<div class="join">
				@pageLink(q, current-1, target, current > 1, "«")
				for _, p := range pages {
					if p == gap {
						<button class="join-item btn btn-sm btn-disabled">…</button>
					} else {
						<a
							href={ templ.SafeURL(PageHref(q, p)) }
							up-follow
							up-target={ target }
							up-history="true"
							class={ "join-item btn btn-sm", templ.KV("btn-active", p == current) }
							aria-current={ ariaCurrent(p == current) }
						>
							{ strconv.Itoa(p) }
						</a>
					}
				}
				@pageLink(q, current+1, target, current < total, "»")
			</div>
		</nav>
	}
}

templ pageLink(q url.Values, page int, target string, enabled bool, label string) {
	if enabled {
		<a href={ templ.SafeURL(PageHref(q, page)) } up-follow up-target={ target } up-history="true" class="join-item btn btn-sm">{ label }</a>
	} else {
		<button class="join-item btn btn-sm btn-disabled" aria-hidden="true">{ label }</button>
	}
}

// CursorHref returns the query string for the next cursor page, preserving
// filters and sort. It drops "page": offset and cursor paging cannot both
// decide what comes next. Pure: q is never mutated.
func CursorHref(q url.Values, cursor string) string {
	n := cloneValues(q)
	n.Del("page")
	if cursor == "" {
		n.Del("cursor")
	} else {
		n.Set("cursor", cursor)
	}
	if len(n) == 0 {
		return "?"
	}
	return "?" + n.Encode()
}

// LoadMoreProps configures the cursor-paged counterpart of Pagination.
type LoadMoreProps struct {
	// Href is the next page, usually CursorHref(q, nextCursor). Empty means
	// the last page: the container renders, the button does not.
	Href string
	// Target is the element whose children are extended, e.g. "#users tbody".
	// The server answers with the whole element; Unpoly keeps its children.
	Target string
	// ID identifies this button so the response can replace it with the next
	// one. Defaults to "load-more"; set it when a screen has two lists.
	ID    string
	Label string // defaults to "Charger la suite"
}

func (p LoadMoreProps) id() string {
	if p.ID == "" {
		return "load-more"
	}
	return p.ID
}

func (p LoadMoreProps) label() string {
	if p.Label == "" {
		return "Charger la suite"
	}
	return p.Label
}

// target appends to the list and swaps the button in one request:
// ".tasks:after, .next-page" is Unpoly's documented pagination pattern.
// Verified against https://unpoly.com/targeting-fragments 2026-08-30 (Unpoly 3).
func (p LoadMoreProps) target() string {
	return p.Target + ":after, #" + p.id()
}

// LoadMore is Pagination for a table nobody can count: it asks for the next
// cursor page and appends the rows instead of replacing them.
//
// Use it over Pagination when COUNT(*) is too expensive or the data shifts
// under the reader; Pagination stays the better answer whenever "page 7 of 42"
// is meaningful.
//
// The wrapper is always rendered, even on the last page: it is the response's
// half of [up-target], and a missing target aborts the update.
//
// [up-history] is false here, against the rule that a state-bearing fragment
// carries it. No URL can mean "pages 1 to 3, appended": stamping the cursor of
// page 3 would make a reload skip pages 1 and 2. The reader's position is not
// shareable by design -- that is the price of not counting.
templ LoadMore(p LoadMoreProps) {
	<div id={ p.id() } class="flex justify-center py-4">
		if p.Href != "" {
			<a
				href={ templ.SafeURL(p.Href) }
				up-follow
				up-target={ p.target() }
				up-history="false"
				class="btn btn-sm btn-ghost"
			>
				{ p.label() }
			</a>
		}
	</div>
}
