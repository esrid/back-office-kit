package ui

import "strconv"

// RefundFormProps bounds a refund by what is actually still refundable.
//
// AlreadyRefundedCents comes from the server: the browser must never be the
// place that decides how much is left, and a second tab must not be able to
// refund the same money twice.
type RefundFormProps struct {
	OrderID              string
	Currency             string
	TotalCents           int64
	AlreadyRefundedCents int64
	Action               string
	Reasons              []Option
	Reason               string
	Error                string
}

// refundableCents is what remains. Never negative, even if the server reports
// more refunded than charged.
func refundableCents(total, already int64) int64 {
	return max(total-already, 0)
}

// centsToInput renders minor units for a step="0.01" number input.
func centsToInput(cents int64) string {
	return strconv.FormatFloat(float64(cents)/100, 'f', 2, 64)
}

// RefundForm offers a full or partial refund, capped server-side and in the
// markup.
templ RefundForm(p RefundFormProps) {
	{{ left := refundableCents(p.TotalCents, p.AlreadyRefundedCents) }}
	{{ totalProps := MoneyProps{Cents: p.TotalCents, Currency: p.Currency} }}
	{{ doneProps := MoneyProps{Cents: p.AlreadyRefundedCents, Currency: p.Currency} }}
	{{ leftProps := MoneyProps{Cents: left, Currency: p.Currency} }}
	<section class="card card-border bg-base-100">
		<form method="post" action={ templ.SafeURL(p.Action) } up-submit class="card-body p-4 gap-4">
			<input type="hidden" name="order_id" value={ p.OrderID }/>
			<h2 class="font-semibold">Rembourser</h2>
			<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
				<dt class="opacity-60">Montant facturé</dt>
				<dd class="justify-self-end">@Money(totalProps)</dd>
				<dt class="opacity-60">Déjà remboursé</dt>
				<dd class="justify-self-end">@Money(doneProps)</dd>
				<dt class="font-medium">Remboursable</dt>
				<dd class="justify-self-end font-medium">@Money(leftProps)</dd>
			</dl>
			if left == 0 {
				<div role="alert" class="alert alert-info">
					<span>Cette commande est intégralement remboursée.</span>
				</div>
			} else {
				@Field(FieldProps{
					Name: "amount", Label: "Montant à rembourser", Type: "number",
					Value: centsToInput(left), Required: true, Error: p.Error,
					Hint: "Au maximum " + FormatMoney(left, p.Currency) + ".",
				})
				@SelectField(FieldProps{
					Name: "reason", Label: "Motif", Value: p.Reason, Required: true,
					Placeholder: "Choisir un motif",
				}, p.Reasons)
				<div class="flex items-center gap-2">
					<button type="submit" class="btn btn-primary btn-sm">Rembourser</button>
					<span class="text-xs opacity-55">Le serveur revérifie le plafond avant d'exécuter.</span>
				</div>
			}
		</form>
	</section>
}
