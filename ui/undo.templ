package ui

// UndoProps offers a bounded window to take back a completed action.
// The action already happened -- this is not a confirmation. BulkActionBar can
// suspend two hundred accounts in one click; this is what catches it.
type UndoProps struct {
	Message   string // what was done: "12 comptes suspendus"
	Action    string // POST endpoint that reverses it
	ReceiptID string // the exact operation to reverse, never "the last one"
	ExpiresIn string // human phrasing of the window, e.g. "30 secondes"
}

// UndoSnackbar is a form, never a link: undoing changes state, and
// http.CrossOriginProtection always lets GET through.
templ UndoSnackbar(p UndoProps) {
	if p.Message != "" {
		<div class="toast toast-center toast-bottom z-30">
			<div class="alert bg-base-content text-base-100 shadow-lg flex-row items-center gap-4" role="status" aria-live="polite">
				<span class="text-sm">{ p.Message }</span>
				<form method="post" action={ templ.SafeURL(p.Action) } up-submit class="contents">
					<input type="hidden" name="receipt_id" value={ p.ReceiptID }/>
					<button type="submit" class="btn btn-sm">Annuler</button>
				</form>
				if p.ExpiresIn != "" {
					<span class="text-xs opacity-60 whitespace-nowrap">encore { p.ExpiresIn }</span>
				}
			</div>
		</div>
	}
}
