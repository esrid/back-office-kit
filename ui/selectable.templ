package ui

import "net/url"

type TableSelection struct {
	Name         string
	Action       string
	Selected     map[string]bool
	All          bool
	BulkSingular string
	BulkMany     string
	BulkActions  templ.Component
}

// SelectableDataTable adds native form selection to DataTable. The server
// receives repeated selection.Name values and re-renders the selected state.
templ SelectableDataTable[T any](id string, cols []Column[T], rows []T, q url.Values, rowKey func(T) string, selection TableSelection, empty templ.Component) {
	<form id={ id } method="post" action={ templ.SafeURL(selection.Action) } up-submit up-target={ "#" + id } class="flex flex-col gap-3">
		if len(rows) == 0 {
			if empty != nil {
				@empty
			} else {
				@EmptyState("Aucun résultat", "Aucune ligne ne correspond à ces filtres.", nil)
			}
		} else {
			<div class="overflow-x-auto rounded-box border border-base-300">
				<table class="table table-sm table-zebra">
					<thead>
						<tr>
							<th class="w-10"><input type="checkbox" class="checkbox checkbox-sm" name="select_all" value="1" checked?={ selection.All } aria-label="Sélectionner toutes les lignes"/></th>
							for _, c := range cols {
								<th class={ c.Class }>
									if c.Sort != "" {
										<a href={ templ.SafeURL(SortHref(q, c.Sort)) } up-follow up-target={ "#" + id } class="inline-flex items-center gap-1">
											{ c.Header } @iconSort(SortDir(q, c.Sort))
										</a>
									} else {
										{ c.Header }
									}
								</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, row := range rows {
							{{ key := rowKey(row) }}
							<tr class={ templ.KV("bg-primary/5", selection.Selected[key]) }>
								<td><input type="checkbox" class="checkbox checkbox-sm" name={ selection.Name } value={ key } checked?={ selection.Selected[key] } aria-label="Sélectionner cette ligne"/></td>
								for _, c := range cols {
									<td class={ c.Class }>
										@c.Cell(row)
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="flex justify-end"><button type="submit" class="btn btn-xs btn-ghost">Actualiser la sélection</button></div>
			{ children... }
			@BulkActionBar(len(selection.Selected), selection.BulkSingular, selection.BulkMany) {
				if selection.BulkActions != nil {
					@selection.BulkActions
				}
			}
		}
	</form>
}
