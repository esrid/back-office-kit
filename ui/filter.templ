package ui

import "net/url"

type FilterKind string

const (
	FilterSearch    FilterKind = "search"
	FilterSelect    FilterKind = "select"
	FilterDateRange FilterKind = "date-range"
)

// Filter is one control of a FilterBar. An empty Options makes it a free-text
// search box.
type Filter struct {
	Kind        FilterKind
	Name        string
	EndName     string
	Label       string
	EndLabel    string
	Placeholder string
	Options     []Option
}

func (f Filter) kind() FilterKind {
	if f.Kind != "" {
		return f.Kind
	}
	if len(f.Options) > 0 {
		return FilterSelect
	}
	return FilterSearch
}

func (f Filter) names() []string {
	if f.kind() == FilterDateRange && f.EndName != "" {
		return []string{f.Name, f.EndName}
	}
	return []string{f.Name}
}

// HasFilters reports whether any of fs currently carries a value in q.
func HasFilters(q url.Values, fs []Filter) bool {
	for _, f := range fs {
		for _, name := range f.names() {
			if q.Get(name) != "" {
				return true
			}
		}
	}
	return false
}

// ResetHref clears every filter and pagination, keeping the sort in place:
// resetting a search should not also throw away the column the user sorted by.
// Pure: q is never mutated.
func ResetHref(q url.Values, fs []Filter) string {
	n := cloneValues(q)
	for _, f := range fs {
		for _, name := range f.names() {
			n.Del(name)
		}
	}
	n.Del("page")
	if len(n) == 0 {
		return "?"
	}
	return "?" + n.Encode()
}

// FilterBar is a GET form whose fields are the query string. Unpoly submits it
// on change and swaps target; without JS it is still a plain form with a
// submit button, and every filter state stays a shareable URL.
//
// Not daisyUI's `filter` component: that one is a radio group with a
// client-side reset, which cannot express "search text + two selects" nor
// survive a page reload as a URL.
templ FilterBar(fs []Filter, q url.Values, target string) {
	<form
		method="get"
		up-target={ target }
		up-history="true"
		up-autosubmit
		class="flex flex-wrap items-center gap-2"
		role="search"
	>
		for _, k := range []string{"sort", "dir"} {
			if q.Get(k) != "" {
				<input type="hidden" name={ k } value={ q.Get(k) }/>
			}
		}
		for _, f := range fs {
			switch f.kind() {
				case FilterDateRange:
					<fieldset class="flex items-center gap-1.5">
						<legend class="sr-only">{ f.Label }</legend>
						<label class="input input-sm w-auto">
							<span class="text-xs opacity-60">{ f.Label }</span>
							<input type="date" name={ f.Name } value={ q.Get(f.Name) } aria-label={ f.Label + " — début" }/>
						</label>
						<span class="opacity-40" aria-hidden="true">→</span>
						<label class="input input-sm w-auto">
							<span class="text-xs opacity-60">{ f.EndLabel }</span>
							<input type="date" name={ f.EndName } value={ q.Get(f.EndName) } aria-label={ f.Label + " — fin" }/>
						</label>
					</fieldset>
				case FilterSearch:
					<label class="input input-sm w-full sm:w-64">
						@iconSearch()
						<input
							type="search"
							name={ f.Name }
							value={ q.Get(f.Name) }
							placeholder={ f.Placeholder }
							aria-label={ f.Label }
							up-watch-delay="300"
						/>
					</label>
				case FilterSelect:
					<select class="select select-sm w-auto" name={ f.Name } aria-label={ f.Label }>
						<option value="" selected?={ q.Get(f.Name) == "" }>{ f.Label } : tous</option>
						for _, o := range f.Options {
							<option value={ o.Value } selected?={ o.Value == q.Get(f.Name) }>{ o.Label }</option>
						}
					</select>
			}
		}
		<noscript>
			<button type="submit" class="btn btn-sm">Filtrer</button>
		</noscript>
		if HasFilters(q, fs) {
			<a
				href={ templ.SafeURL(ResetHref(q, fs)) }
				up-follow
				up-target={ target }
				up-history="true"
				class="btn btn-sm btn-ghost"
			>Réinitialiser</a>
		}
	</form>
}

templ iconSearch() {
	<svg xmlns="http://www.w3.org/2000/svg" class="size-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path stroke-linecap="round" d="M20 20l-3.5-3.5"></path></svg>
}
