package ui

type PolicyFact struct {
	Label string
	Value string
}

type PolicySimulation struct {
	DecisionID        string
	Decision          AccessDecision
	Reason            string
	Policy            string
	EvaluatedAt       string
	EvaluatedDatetime string
	Facts             []PolicyFact
}

type PolicySimulatorProps struct {
	ID          string
	Title       string
	Description string
	Action      string
	Target      string
	Actors      []Option
	Resources   []Option
	Actions     []Option
	Actor       string
	Resource    string
	ActionValue string
	Context     string
	Simulation  *PolicySimulation
}

func policySimulatorTitle(title string) string {
	if title == "" {
		return "Simulateur de politique"
	}
	return title
}

// PolicySimulator sends a read-only GET query to the backend policy engine.
// Its answer is explanatory and never grants or persists access.
//
// The GET form carries [up-history]: a simulation nobody can share by link
// loses the point of a simulator -- "here is why your access is denied" has to
// survive a copy-paste. Verified against a running server.
templ PolicySimulator(p PolicySimulatorProps) {
	<section id={ p.ID } class="card card-border bg-base-100" aria-labelledby={ p.ID + "-title" }>
		<div class="card-body p-4 gap-4">
			<header>
				<h2 id={ p.ID + "-title" } class="font-semibold">{ policySimulatorTitle(p.Title) }</h2>
				if p.Description != "" {
					<p class="mt-1 text-sm opacity-70">{ p.Description }</p>
				}
			</header>
			<form
				method="get"
				action={ templ.SafeURL(p.Action) }
				up-submit
				if p.Target != "" {
					up-target={ p.Target }
					up-history="true"
				}
				class="grid gap-3 md:grid-cols-3"
			>
				<label class="form-control">
					<span class="label-text mb-1 font-medium">Acteur</span>
					<select name="actor" class="select select-bordered w-full" required>
						for _, option := range p.Actors {
							<option value={ option.Value } selected?={ option.Value == p.Actor }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="form-control">
					<span class="label-text mb-1 font-medium">Ressource</span>
					<select name="resource" class="select select-bordered w-full" required>
						for _, option := range p.Resources {
							<option value={ option.Value } selected?={ option.Value == p.Resource }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="form-control">
					<span class="label-text mb-1 font-medium">Action</span>
					<select name="action" class="select select-bordered w-full" required>
						for _, option := range p.Actions {
							<option value={ option.Value } selected?={ option.Value == p.ActionValue }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="form-control md:col-span-3">
					<span class="label-text mb-1 font-medium">Contexte optionnel</span>
					<input type="text" name="context" value={ p.Context } class="input input-bordered w-full" placeholder="Ex. réseau interne, montant=12000"/>
				</label>
				<div class="md:col-span-3 flex justify-end">
					<button type="submit" class="btn btn-primary btn-sm">Évaluer la politique</button>
				</div>
			</form>
			if p.Simulation != nil {
				<div class={ "alert items-start", toneOf(accessDecisionTone(p.Simulation.Decision)).Alert } role="status" aria-live="polite" data-decision-id={ p.Simulation.DecisionID }>
					<div class="w-full">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<strong>{ accessDecisionLabel(p.Simulation.Decision) }</strong>
							if p.Simulation.EvaluatedAt != "" {
								<time class="text-xs opacity-70" datetime={ p.Simulation.EvaluatedDatetime }>{ p.Simulation.EvaluatedAt }</time>
							}
						</div>
						if p.Simulation.Reason != "" {
							<p class="mt-1 text-sm">{ p.Simulation.Reason }</p>
						}
						<dl class="mt-3 grid gap-2 text-xs sm:grid-cols-2">
							if p.Simulation.Policy != "" {
								<div><dt class="font-medium">Politique</dt><dd class="opacity-80">{ p.Simulation.Policy }</dd></div>
							}
							if p.Simulation.DecisionID != "" {
								<div><dt class="font-medium">Référence</dt><dd class="font-mono opacity-80">{ p.Simulation.DecisionID }</dd></div>
							}
							for _, fact := range p.Simulation.Facts {
								<div><dt class="font-medium">{ fact.Label }</dt><dd class="opacity-80">{ fact.Value }</dd></div>
							}
						</dl>
						<p class="mt-3 text-xs opacity-70">Simulation uniquement : aucun accès n’a été accordé.</p>
					</div>
				</div>
			}
		</div>
	</section>
}
