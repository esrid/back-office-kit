package ui

import "strconv"

// plural picks the form matching n. Deterministic; no locale lookup.
func plural(n int, singular, many string) string {
	if n <= 1 {
		return singular
	}
	return many
}

// BulkActionBar only renders when at least one row is selected.
templ BulkActionBar(selected int, singular string, many string) {
	if selected > 0 {
		<div class="sticky bottom-4 z-10 flex items-center justify-between gap-4 rounded-box border border-base-300 bg-base-content text-base-100 px-4 py-2 shadow-lg">
			<p class="text-sm font-medium" role="status" aria-live="polite"><span class="tabular-nums">{ strconv.Itoa(selected) }</span> { plural(selected, singular, many) }</p>
			<div class="flex items-center gap-2">
				{ children... }
			</div>
		</div>
	}
}
