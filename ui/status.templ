package ui

// StatusBadge renders a status with a colour derived from ToneFor, so the
// same state looks the same on every screen.
//
// Solid variants, not badge-soft: soft pills draw the label in the semantic
// colour on a tint of it, which measures 1.7:1 to 2.6:1 in the light theme and
// 1.2:1 for neutral in the dark theme. Solid pills pair each colour with its
// *-content foreground and hold 5.1:1 or better in both themes.
templ StatusBadge(status string) {
	<span class={ "badge badge-sm", toneOf(ToneFor(status)).Badge }>{ status }</span>
}
