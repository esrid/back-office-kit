package ui

import (
	"strconv"
	"strings"
)

// MoneyProps renders an amount.
//
// Cents is minor units as an integer, never a float: 0.1 + 0.2 is not 0.3 in
// binary floating point, and money that drifts by a centime per operation is
// the oldest bug in commerce software.
type MoneyProps struct {
	Cents    int64
	Currency string // ISO 4217: "EUR", "USD", "JPY"
	Tone     string // optional semantic colour, e.g. "error" for a refund
	Sign     bool   // force a leading + on positive amounts
}

// minorUnits is the number of decimals a currency actually has. Assuming two
// turns ¥1000 into ¥10.00.
var minorUnits = map[string]int{
	"JPY": 0, "KRW": 0, "VND": 0, "CLP": 0, "ISK": 0,
	"BHD": 3, "KWD": 3, "OMR": 3, "TND": 3,
}

var currencySymbols = map[string]string{
	"EUR": "€", "USD": "$", "GBP": "£", "JPY": "¥", "CHF": "CHF",
}

func decimalsFor(currency string) int {
	if d, ok := minorUnits[strings.ToUpper(currency)]; ok {
		return d
	}
	return 2
}

func symbolFor(currency string) string {
	if s, ok := currencySymbols[strings.ToUpper(currency)]; ok {
		return s
	}
	return strings.ToUpper(currency)
}

// groupThousands inserts a no-break space every three digits, French style.
func groupThousands(digits string) string {
	var b strings.Builder
	for i, r := range digits {
		if i > 0 && (len(digits)-i)%3 == 0 {
			b.WriteString(" ")
		}
		b.WriteRune(r)
	}
	return b.String()
}

// FormatMoney renders minor units as a French-formatted amount.
// Pure and total: every int64 has an output, including the extremes.
func FormatMoney(cents int64, currency string) string {
	decimals := decimalsFor(currency)

	negative := cents < 0
	digits := strconv.FormatInt(cents, 10)
	if negative {
		digits = digits[1:] // FormatInt already wrote the sign
	}
	for len(digits) <= decimals {
		digits = "0" + digits
	}

	whole, frac := digits, ""
	if decimals > 0 {
		whole, frac = digits[:len(digits)-decimals], ","+digits[len(digits)-decimals:]
	}

	out := groupThousands(whole) + frac + " " + symbolFor(currency)
	if negative {
		return "−" + out // U+2212 minus, not a hyphen: it aligns with digits
	}
	return out
}

// Money renders an amount ready to sit in a column of amounts.
templ Money(p MoneyProps) {
	{{ text := FormatMoney(p.Cents, p.Currency) }}
	if p.Sign && p.Cents > 0 {
		{{ text = "+" + text }}
	}
	<span class={ "tabular-nums whitespace-nowrap", toneOf(p.Tone).Text }>{ text }</span>
}
